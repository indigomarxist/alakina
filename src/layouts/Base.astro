---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import ogSource from '../assets/photos/three-quarter.jpg';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} | ${profile.tagline}`,
  description = `${profile.name} is an AMDA-trained model, actress and singer based in ${profile.based}. Portfolio, resume, measurements and booking contact.`,
} = Astro.props;

const og = await getImage({ src: ogSource, width: 1200, height: 1500, fit: 'cover', format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: ['Model', 'Actress', 'Singer'],
  email: `mailto:${profile.email}`,
  url: Astro.site?.toString(),
  sameAs: [`https://www.instagram.com/${profile.instagram}/`, `https://www.tiktok.com/@${profile.tiktok}`],
  alumniOf: profile.training.school,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#3a0f18" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script>
      // Y2K sparkle trail behind the mouse; skipped on touch screens and for reduced motion.
      if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const colors = ['#f28db8', '#e4c77a', '#e0457b', '#fffdf8', '#d8d8de'];
        let last = 0;
        addEventListener('pointermove', (e) => {
          if (e.timeStamp - last < 45) return;
          last = e.timeStamp;
          const s = document.createElement('span');
          s.className = 'trail';
          s.style.left = `${e.clientX - 7}px`;
          s.style.top = `${e.clientY - 7}px`;
          s.style.setProperty('--c', colors[Math.floor(Math.random() * colors.length)]);
          s.style.setProperty('--dx', `${Math.round(Math.random() * 30 - 15)}px`);
          s.addEventListener('animationend', () => s.remove());
          document.body.append(s);
        });
      }
    </script>
  </body>
</html>
