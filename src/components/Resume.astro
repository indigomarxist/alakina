---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const credits = (await getCollection('credits')).sort((a, b) => a.data.order - b.data.order);
const sections = [
  { key: 'stage-film', heading: 'Stage & Film' },
  { key: 'modeling', heading: 'Modeling' },
] as const;
---

<section class="section resume-section" id="resume">
  <div class="container">
    <div class="resume__head">
      <div>
        <p class="eyebrow">Resume</p>
        <h2 class="section-title">Credits &amp; <em>training</em></h2>
      </div>
      <a class="btn" href={profile.files.resume} download>Download resume (PDF)</a>
    </div>

    {
      sections.map(({ key, heading }) => (
        <div class="block" data-key={key}>
          <h3>{heading}</h3>
          <table>
            <thead class="visually-hidden">
              <tr><th scope="col">Production</th><th scope="col">Role</th><th scope="col">Company</th></tr>
            </thead>
            <tbody>
              {credits
                .filter((c) => c.data.section === key)
                .map((c) => (
                  <tr>
                    <th scope="row">{c.data.title}</th>
                    <td>{c.data.role}</td>
                    <td class="company">{c.data.company}</td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
      ))
    }

    <div class="block cols">
      <div>
        <h3>Training</h3>
        <div class="row">
          <p class="row__title">{profile.training.school}</p>
          <p class="row__meta">{profile.training.program} · {profile.training.years}</p>
        </div>
      </div>
      <div>
        <h3>Skills</h3>
        <ul class="skills">{profile.skills.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* The one light section: bone paper with ink, like a printed credits page. */
  .resume-section {
    --text: var(--ink);
    --muted: var(--ink-soft);
    --line: color-mix(in srgb, var(--ink) 18%, transparent);
    --accent: var(--oxblood);
    background: var(--paper);
    color: var(--ink);
  }
  .resume-section :focus-visible { outline-color: var(--oxblood); }
  .resume-section .btn { color: var(--ink); border-color: color-mix(in srgb, var(--ink) 55%, transparent); }
  .resume-section .btn:hover, .resume-section .btn:focus-visible { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .resume__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; }
  .resume__head .section-title { margin-bottom: 0; }
  .block { margin-top: clamp(3rem, 6vw, 4.5rem); }
  h3 {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ink);
  }
  table { width: 100%; border-collapse: collapse; }
  tr { border-bottom: 1px solid var(--line); }
  th, td { text-align: left; padding: 1.1rem 1rem 1.1rem 0; vertical-align: baseline; }
  tbody th { font-family: var(--serif); font-size: 1.55rem; font-weight: 400; width: 38%; line-height: 1.2; }
  td { width: 26%; }
  td:not(.company) { font-family: var(--serif); font-style: italic; font-size: 1.25rem; color: var(--oxblood); }
  .company { color: var(--ink-soft); font-size: 0.95rem; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); }
  .row { padding: 1.1rem 0 1rem; }
  .row__title { margin: 0; font-family: var(--serif); font-size: 1.55rem; line-height: 1.25; }
  .row__meta { margin: 0.25rem 0 0; color: var(--ink-soft); }
  .skills { list-style: none; margin: 0; padding: 0; }
  .skills li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  @media (max-width: 700px) {
    table, tbody, tr, tbody th, td { display: block; }
    tr { padding: 0.9rem 0; }
    tbody th, td { width: auto; padding: 0; }
    td { font-size: 0.95rem; }
    .cols { grid-template-columns: 1fr; }
  }
</style>
