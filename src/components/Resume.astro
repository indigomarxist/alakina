---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const credits = (await getCollection('credits')).sort((a, b) => a.data.order - b.data.order);
const sections = [
  { key: 'stage-film', heading: 'Stage & Film' },
  { key: 'modeling', heading: 'Modeling' },
] as const;
---

<section class="section resume-section paper torn-top" id="resume">
  <div class="container">
    <div class="resume__head">
      <div>
        <p class="eyebrow">Resume</p>
        <h2 class="section-title">Credits &amp; <em>training</em></h2>
      </div>
      <a class="btn" href={profile.files.resume} download>Download resume (PDF)</a>
    </div>

    {
      sections.map(({ key, heading }) => (
        <div class="block" data-key={key}>
          <h3>{heading}</h3>
          <table>
            <thead class="visually-hidden">
              <tr><th scope="col">Production</th><th scope="col">Role</th><th scope="col">Company</th></tr>
            </thead>
            <tbody>
              {credits
                .filter((c) => c.data.section === key)
                .map((c) => (
                  <tr>
                    <th scope="row">{c.data.title}</th>
                    <td>{c.data.role}</td>
                    <td class="company">{c.data.company}</td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
      ))
    }

    <div class="block cols">
      <div>
        <h3>Training</h3>
        <div class="row">
          <p class="row__title">{profile.training.school}</p>
          <p class="row__meta">{profile.training.program} · {profile.training.years}</p>
        </div>
      </div>
      <div>
        <h3>Skills</h3>
        <ul class="skills">{profile.skills.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .resume-section { --sc: var(--paper); }
  .resume__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; }
  .resume__head .section-title { margin-bottom: 0; }
  .block { margin-top: clamp(3rem, 6vw, 4.25rem); }
  /* Section labels look like tape strips. */
  h3 {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    padding: 0.45rem 1.2rem;
    background: var(--wine);
    color: var(--cream);
    transform: rotate(-1.5deg);
    clip-path: polygon(0 0, 3% 20%, 0 40%, 3% 60%, 0 80%, 2% 100%, 98% 100%, 100% 80%, 97% 60%, 100% 40%, 97% 20%, 100% 0);
    margin-bottom: 0.9rem;
  }
  [data-key='modeling'] h3 { background: var(--teal); transform: rotate(1deg); }
  .cols > div:first-child h3 { background: var(--olive); }
  .cols > div:last-child h3 { background: var(--burgundy); transform: rotate(1.2deg); }
  table { width: 100%; border-collapse: collapse; }
  tr { border-bottom: 1px solid var(--line); }
  th, td { text-align: left; padding: 1.05rem 1rem 1.05rem 0; vertical-align: baseline; }
  tbody th { font-family: var(--serif); font-size: 1.35rem; font-weight: 400; width: 38%; line-height: 1.25; }
  td { width: 26%; }
  td:not(.company) { font-family: var(--serif); font-style: italic; font-size: 1.15rem; color: var(--burgundy); }
  .company { color: var(--ink-soft); font-size: 0.95rem; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); }
  .row { padding: 0.5rem 0 1rem; }
  .row__title { margin: 0; font-family: var(--serif); font-size: 1.35rem; line-height: 1.3; }
  .row__meta { margin: 0.25rem 0 0; color: var(--ink-soft); }
  .skills { list-style: none; margin: 0; padding: 0.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .skills li {
    padding: 0.3rem 1rem 0.4rem;
    border-radius: 999px;
    background: var(--cream);
    border: 1px solid var(--line);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  @media (max-width: 700px) {
    table, tbody, tr, tbody th, td { display: block; }
    tr { padding: 0.9rem 0; }
    tbody th, td { width: auto; padding: 0; }
    td { font-size: 0.95rem; }
    .cols { grid-template-columns: 1fr; }
  }
</style>
