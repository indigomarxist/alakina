---
import Cutout from './Cutout.astro';
import Win from './Win.astro';
import Sticker from './Sticker.astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

const repoVideos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);

// YouTube links from Alakina's Drive links doc (scripts/sync-drive.mjs), shown first.
type DriveVideo = { id: string; title: string };
const driveVideos: DriveVideo[] =
  Object.values(import.meta.glob<DriveVideo[]>('../assets/photos/drive/videos.json', { eager: true, import: 'default' }))[0] ?? [];
// Short clips from her Drive "Videos" folder, converted at build time. Once there are
// any, they replace the self-hosted clips kept in the repo.
type DriveClip = { id: string; title: string; src: string; poster: string; orientation: 'portrait' | 'landscape' };
const driveClips: DriveClip[] =
  Object.values(import.meta.glob<DriveClip[]>('../assets/photos/drive/clips.json', { eager: true, import: 'default' }))[0] ?? [];
const posters = import.meta.glob<ImageMetadata>('../assets/photos/drive/posters/*.jpg', { eager: true, import: 'default' });
const clipVideos = driveClips
  .filter((c) => posters[`../assets/photos/drive/${c.poster}`])
  .map((c) => ({
    id: `drive-clip-${c.id}`,
    data: { kind: 'file' as const, title: c.title, caption: undefined, order: 0, src: c.src, poster: posters[`../assets/photos/drive/${c.poster}`], orientation: c.orientation },
  }));

const videos = [
  ...driveVideos.map((v) => ({ id: `drive-${v.id}`, data: { kind: 'youtube' as const, title: v.title, youtubeId: v.id, caption: undefined, order: 0 } })),
  ...clipVideos,
  ...repoVideos.filter((v) => clipVideos.length === 0 || v.data.kind !== 'file'),
];
const items = await Promise.all(
  videos.map(async ({ id, data }) => ({
    id,
    data,
    poster: data.kind === 'file' ? (await getImage({ src: data.poster, width: 1080, format: 'webp' })).src : undefined,
  })),
);
---

{
  items.length > 0 && (
    <section class="section video velvet dust torn-top" id="video">
      <div class="container">
        <Sticker kind="star" size="3.5rem" rotate={14} style="top:-1rem;right:6%" />
        <Sticker kind="lips" size="3.2rem" rotate={-12} style="top:30%;left:-1rem;animation-delay:-2s" />
        <p class="eyebrow">Video</p>
        <h2 class="section-title">In <Cutout text="motion" /></h2>
        <ul class="videos">
          {items.map(({ id, data, poster }) => (
            <li class:list={['videos__item', data.kind === 'file' && `videos__item--${data.orientation}`]}>
              <Win title={`${data.title.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '')}.${data.kind === 'file' ? 'mov' : 'avi'}`} class="videos__win">
              <div class="videos__frame">
                {data.kind === 'file' ? (
                  <video src={data.src} poster={poster} controls playsinline preload="none" aria-label={data.title} />
                ) : (
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${data.youtubeId}?rel=0`}
                    title={data.title}
                    loading="lazy"
                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                    allowfullscreen
                  />
                )}
              </div>
              </Win>
              <p class="videos__title">{data.title}</p>
              {data.caption && <p class="videos__caption">{data.caption}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .video .container { position: relative; }
  .videos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: flex-start;
    justify-content: center;
  }
  .videos__item { flex: 1 1 32rem; max-width: 48rem; }
  .videos__item--portrait { flex: 0 1 22rem; }
  .videos__item:nth-child(odd) { transform: rotate(-1.5deg); }
  .videos__item:nth-child(even) { transform: rotate(1.5deg); }
  .video { --v: var(--olive); --sc: var(--olive); text-align: center; }
  .video :global(.eyebrow) { margin-inline: auto; }
  .videos__win :global(.win__body) { padding: 0.4rem; }
  .videos__frame { background: var(--ink); aspect-ratio: 16 / 9; overflow: hidden; }
  .videos__item--portrait .videos__frame { aspect-ratio: 9 / 16; }
  .videos__frame video,
  .videos__frame iframe { display: block; width: 100%; height: 100%; border: 0; object-fit: cover; }
  .videos__title { font-family: var(--hand); font-weight: 700; font-size: 2rem; line-height: 1; margin: 1.1rem 0 0.2rem; color: var(--blush); }
  .videos__caption { color: var(--muted); margin: 0; }
</style>
