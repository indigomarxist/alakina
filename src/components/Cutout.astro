---
// Ransom-note style word: each letter on its own scrap of paper.
interface Props {
  text: string;
}
const { text } = Astro.props;
const looks = ['a', 'b', 'c', 'd', 'e', 'f'];
const tilts = [-6, 4, -2, 7, -4, 3, -7, 5, 1, -3];
---

<span class="cutout"><span class="visually-hidden">{text}</span>
  {[...text].map((ch, i) =>
    ch === ' ' ? <span class="cutout__gap" aria-hidden="true" /> : (
      <span class={`cutout__l cutout__l--${looks[(i * 7 + ch.charCodeAt(0)) % looks.length]}`} style={`--t:${tilts[i % tilts.length]}deg`} aria-hidden="true">{ch}</span>
    ),
  )}
</span>

<style>
  .cutout { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.06em; vertical-align: middle; }
  .cutout__gap { width: 0.3em; }
  .cutout__l {
    display: inline-block;
    padding: 0.04em 0.12em 0.08em;
    line-height: 1;
    transform: rotate(var(--t));
    box-shadow: 1px 2px 2px rgb(42 22 23 / 0.3);
  }
  .cutout__l--a { background: var(--wine); color: var(--blush); font-family: var(--serif); font-style: italic; }
  .cutout__l--b { background: #fff; color: var(--ink); font-family: var(--serif); font-weight: 800; }
  .cutout__l--c { background: #ff8fc8; color: var(--ink); font-family: var(--sans); font-weight: 700; text-transform: uppercase; font-size: 0.85em; }
  .cutout__l--d { background: var(--leopard) 0 0 / 70px 70px; color: var(--ink); font-family: var(--serif); font-weight: 800; text-shadow: 0 0 4px #fff, 0 0 2px #fff; }
  .cutout__l--e { background: var(--olive); color: var(--cream); font-family: 'VT323', monospace; font-size: 1.1em; }
  .cutout__l--f { background: var(--gold-light); color: var(--wine); font-family: var(--script); font-size: 1.1em; padding-inline: 0.18em; }
</style>
