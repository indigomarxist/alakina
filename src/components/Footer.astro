---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p><span class="footer__name">{profile.name}</span> © {year}</p>
    <div class="footer__links">
      <a href={`https://www.instagram.com/${profile.instagram}/`} rel="noopener">Instagram</a>
      <a href={`https://www.tiktok.com/@${profile.tiktok}`} rel="noopener">TikTok</a>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: 2.5rem; background: var(--night); color: var(--muted); border-top: 1px solid var(--line); }
  .footer__inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; }
  p { margin: 0; }
  .footer__name { font-family: var(--serif); font-size: 1.05rem; letter-spacing: 0.36em; color: var(--bone); margin-right: 0.75rem; }
  .footer__links { display: flex; gap: 0.5rem; }
  a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; padding: 0.5rem 0.75rem; transition: color 0.3s var(--ease); }
  a:hover { color: var(--champagne); }
</style>
