---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {profile.name}</p>
    <a href={`https://www.instagram.com/${profile.instagram}/`} rel="noopener">Instagram</a>
  </div>
</footer>

<style>
  .footer { padding-block: 2rem; border-top: 1px solid var(--line); }
  .footer__inner { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  p { margin: 0; }
  a { text-decoration: none; }
  a:hover { color: var(--text); }
</style>
