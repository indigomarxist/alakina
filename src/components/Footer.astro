---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p><span class="footer__name">{profile.name}</span> © {year}</p>
    <div class="footer__links">
      <a href={`https://www.instagram.com/${profile.instagram}/`} rel="noopener">Instagram</a>
      <a href={`https://www.tiktok.com/@${profile.tiktok}`} rel="noopener">TikTok</a>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: 2.25rem; background: var(--ink); color: color-mix(in srgb, var(--ivory) 75%, transparent); }
  .footer__inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; }
  p { margin: 0; }
  .footer__name { font-family: var(--script); font-size: 2.1rem; letter-spacing: 0; text-transform: none; color: var(--ivory); margin-right: 0.6rem; vertical-align: -0.2em; }
  .footer__links { display: flex; gap: 0.5rem; }
  a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; padding: 0.5rem 1rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--ivory) 30%, transparent); transition: background 0.3s var(--ease), color 0.3s var(--ease); }
  a:hover { background: var(--ivory); color: var(--ink); }
</style>
