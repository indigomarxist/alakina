---
import { Image } from 'astro:assets';
import cutout from '../assets/cutouts/full-length.webp';
import second from '../assets/photos/headshot-smile.jpg';
import { profile } from '../data/profile';
import Win from './Win.astro';

const roles = profile.tagline.split('·').map((r) => r.trim());

// A swatch board: real fabric photographs (public/fabrics, credits in
// CREDITS.md), cut square and pinned in a tidy grid like a designer's sample
// card, each with a mono caption.
const swatches = [
  ['rose', 'velvet rose'],
  ['leopard', 'leopard'],
  ['mauve', 'mauve velvet'],
  ['zebra', 'zebra'],
  ['olive', 'olive velvet'],
  ['peacock', 'peacock velvet'],
] as const;
---

<section class="hero" id="top">
  <div class="container hero__stage">
    <div class="board">
      <div class="board__grid" aria-hidden="true">
      {swatches.map(([file, label], i) => (
        <figure class="swatch">
          <span class="swatch__cloth" style={`--f:url('/fabrics/${file}.webp')`}></span>
          <figcaption>
            <span>{String(i + 1).padStart(2, '0')}</span>
            {label}
          </figcaption>
        </figure>
      ))}
      </div>
      <figure class="hero__cut">
        <Image
        src={cutout}
        alt="Alakina Lee, full-length portrait in a black bodysuit and jeans"
        widths={[380, 560, 771]}
        sizes="(max-width: 800px) 58vw, 22vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={88}
      />
      </figure>
    </div>

    <p class="hero__tags">
      <span class="dymo">{profile.based}</span>
      <span class="dymo dymo--pink">now booking</span>
    </p>

    <p class="hero__pre" aria-hidden="true">the portfolio of</p>
    <h1 class="hero__title">
      <span class="hero__first">Alakina</span>
      <em class="hero__last glitter">Lee</em>
    </h1>


    <ul class="hero__roles">
      {roles.map((r) => <li class="role">{r}</li>)}
    </ul>

    <div class="hero__dock">
      <figure class="hero__snap">
        <Image src={second} alt="Alakina Lee smiling, headshot" widths={[240, 360, 520]} sizes="(max-width: 800px) 8rem, 11rem" format="avif" />
        <figcaption class="hand">it's me!</figcaption>
      </figure>

      <Win title="Bookings" skin="leopard" status={`now booking · ${profile.based}`} class="hero__win">
        <p class="hero__win-text">Now booking editorial, runway, stage and screen.</p>
        <div class="hero__actions">
          <a class="btn btn--solid" href="#contact">Booking inquiries</a>
          <a class="btn btn--win" href={profile.files.compCard} download>Comp card</a>
        </div>
      </Win>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    overflow: clip;
    padding-block: 2.5rem 0;
    /* Real oxblood velvet, darkened at the edges so the blush title keeps its contrast. */
    background-color: var(--wine);
    background-image:
      radial-gradient(120% 90% at 28% 35%, rgb(30 6 12 / 0.15), rgb(20 3 8 / 0.72)),
      url('/fabrics/oxblood.webp');
    background-size: 100% 100%, cover;
    background-position: center;
  }
  /* Fine film grain over everything, so photo, fabric and type sit in one print. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 8;
    pointer-events: none;
    background-image: var(--grain);
    opacity: 0.55;
    mix-blend-mode: soft-light;
  }

  .hero__stage {
    position: relative;
    height: clamp(40rem, calc(100vh - 7rem), 54rem);
  }

  /* ---- Swatch board: a straight 2 x 3 grid with even gutters ---- */
  /* No z-index here on purpose: the title sits over the swatches and the
     cutout (z 2) over the title, all in the stage's stacking context. */
  .board {
    position: absolute;
    top: 1.5rem;
    bottom: 2.5rem;
    left: 55%;
    right: 0;
  }
  .board__grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 0.9rem;
    padding: 0.9rem;
    background: rgb(20 3 8 / 0.35);
    outline: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    outline-offset: -0.45rem;
  }
  .swatch {
    position: relative;
    margin: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--cream);
    padding: 0.35rem 0.35rem 0;
    box-shadow: 5px 5px 0 rgb(20 3 8 / 0.6);
  }
  .swatch__cloth {
    flex: 1;
    min-height: 0;
    display: block;
    background: var(--wine) var(--f) center / cover no-repeat;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }
  .swatch figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.3rem 0.1rem 0.35rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wine);
    white-space: nowrap;
  }
  .swatch figcaption span { color: var(--rose); }

  /* ---- Type ---- */
  .hero__tags { position: absolute; z-index: 5; left: 0; top: 0.5rem; display: flex; gap: 0.75rem; margin: 0; }
  .hero__tags .dymo { transform: none; }

  .hero__title { margin: 0; font-weight: 400; line-height: 0.8; }
  .hero__first {
    position: absolute;
    z-index: 1;
    left: -0.04em;
    top: 13%;
    font-size: clamp(5rem, 16vw, 17rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--blush);
    text-shadow: 5px 5px 0 var(--wine);
  }
  .hero__pre {
    position: absolute;
    z-index: 3;
    left: 20%;
    top: 5%;
    margin: 0;
    font-family: var(--script);
    font-size: clamp(2.2rem, 4.2vw, 4.2rem);
    line-height: 1;
    color: var(--gold-light);
    transform: rotate(-3deg);
  }
  .hero__last {
    position: absolute;
    z-index: 4;
    left: 34%;
    top: 34%;
    font-size: clamp(5.5rem, 13vw, 13rem);
    line-height: 1;
    transform: rotate(-6deg);
  }

  .hero__cut {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: -2.5rem;
    height: calc(100% + 3rem);
    margin: 0;
    transform: translateX(-50%);
    filter: drop-shadow(8px 8px 0 rgb(20 3 8 / 0.55));
  }
  .hero__cut :global(img) { height: 100%; width: auto; }

  .hero__roles {
    position: absolute;
    z-index: 5;
    left: 0;
    top: 50%;
    display: flex;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .role {
    padding: 0.3rem 1rem 0.35rem;
    border: 1.5px solid var(--gold-light);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.1;
    color: var(--blush);
    background: rgb(20 3 8 / 0.4);
  }

  /* Polaroid and booking window share a baseline. */
  .hero__dock {
    position: absolute;
    z-index: 6;
    left: 0;
    bottom: 2.5rem;
    width: 52%;
    display: flex;
    align-items: flex-end;
    gap: 1.75rem;
  }
  .hero__snap {
    position: relative;
    flex: none;
    width: clamp(8rem, 11vw, 10.5rem);
    margin: 0;
    padding: 0.45rem 0.45rem 2.1rem;
    background: var(--white);
    transform: rotate(-3deg);
    box-shadow: var(--hard);
  }
  .hero__snap :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 50% 22%; }
  .hero__snap figcaption { position: absolute; left: 0; right: 0; bottom: 0.25rem; text-align: center; font-size: 1.5rem; line-height: 1.2; color: var(--wine); }

  .hero :global(.hero__win) { flex: 1; max-width: 23rem; transform: rotate(1deg); }
  .hero__win-text { margin: 0 0 1rem; font-family: var(--serif); font-size: 1.2rem; line-height: 1.3; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero .btn--win { color: var(--ink); border-color: var(--ink); }

  @media (max-width: 1100px) {
    .hero__dock { width: 56%; gap: 1.25rem; }
    .hero__snap { display: none; }
  }

  /* ---- Phones and small tablets: stacked, nothing positioned past the edges ---- */
  @media (max-width: 800px) {
    .hero { padding-top: 1.25rem; }
    .hero__stage { height: auto; display: flex; flex-direction: column; padding-bottom: 3rem; }
    .hero__tags { position: relative; top: 0; }
    .hero__pre { display: none; }
    .hero__first { position: relative; display: block; top: auto; left: -0.03em; margin-top: 0.9rem; font-size: 20vw; text-shadow: 4px 4px 0 var(--wine); }
    .hero__last { position: relative; display: block; top: auto; left: auto; margin: -0.35em 0 0 auto; width: max-content; padding-right: 4%; font-size: 22vw; }

    /* Board becomes a 3 x 2 card the figure stands in front of. */
    .board { position: relative; top: auto; bottom: auto; left: auto; right: auto; order: 3; margin-top: 1.25rem; aspect-ratio: 1 / 1.3; }
    .board__grid {
      top: 28%;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 0.5rem;
      padding: 0.5rem;
      outline-offset: -0.25rem;
    }
    .swatch { padding: 0.25rem 0.25rem 0; box-shadow: 3px 3px 0 rgb(20 3 8 / 0.6); }
    .swatch figcaption { font-size: 0.5rem; letter-spacing: 0.04em; padding-block: 0.2rem 0.25rem; }
    .swatch figcaption span { display: none; }
    .hero__cut { bottom: -0.75rem; height: calc(100% + 0.75rem); filter: drop-shadow(4px 4px 0 rgb(20 3 8 / 0.5)); }
    .hero__roles { position: relative; order: 5; top: auto; justify-content: center; flex-wrap: wrap; margin-top: 1.25rem; }
    .role { font-size: 1.15rem; }
    .hero__dock { position: relative; order: 6; left: auto; bottom: auto; width: 100%; margin-top: 1.5rem; }
    .hero :global(.hero__win) { max-width: none; transform: none; }
  }
</style>
