---
import { Image } from 'astro:assets';
import hero from '../assets/photos/full-length.jpg';
import { profile } from '../data/profile';

const roles = profile.tagline.split('·').map((r) => r.trim());
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">{profile.based}</p>
      <h1>Alakina <em>Lee</em></h1>
      <p class="hero__tagline">
        {roles.map((r) => <span>{r}</span>)}
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="#contact">Booking inquiries</a>
        <a class="btn" href={profile.files.compCard} download>Comp card</a>
      </div>
    </div>

    <figure class="hero__art">
      <div class="hero__photo">
        <Image
          src={hero}
          alt="Alakina Lee, full-length portrait in a black bodysuit and jeans"
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 800px) 90vw, 42vw"
          loading="eager"
          fetchpriority="high"
          format="avif"
        />
      </div>
      <figcaption>Portfolio <span>{new Date().getFullYear()}</span></figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
    background:
      radial-gradient(60% 70% at 78% 40%, color-mix(in srgb, var(--oxblood) 45%, transparent), transparent 70%),
      var(--night);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  h1 {
    font-size: clamp(4.2rem, 11vw, 9.5rem);
    line-height: 0.88;
    letter-spacing: -0.02em;
  }
  h1 em { display: block; padding-left: 0.9em; }
  .hero__tagline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.1rem;
    margin: 2.5rem 0 2.75rem;
    font-size: 0.8rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__tagline span + span::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    margin-right: 1.1rem;
    vertical-align: middle;
    background: var(--champagne);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; }

  .hero__art { position: relative; justify-self: center; width: min(100%, 30rem); margin: 0; }
  .hero__art::before {
    content: '';
    position: absolute;
    inset: -1.1rem 1.1rem 2.4rem -1.1rem;
    border: 1px solid color-mix(in srgb, var(--champagne) 55%, transparent);
    pointer-events: none;
  }
  .hero__photo { position: relative; overflow: hidden; background: var(--night-2); }
  .hero__photo :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4.2;
    object-fit: cover;
    object-position: 50% 25%;
    filter: saturate(0.85) contrast(1.05);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--muted);
  }
  figcaption span { font-family: var(--serif); font-style: italic; font-size: 1rem; letter-spacing: 0.05em; text-transform: none; color: var(--champagne); }

  @media (max-width: 800px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__art { order: -1; width: min(74%, 21rem); margin: 1rem 0 0 1rem; }
  }
</style>
