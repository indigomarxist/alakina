---
// Decorative daisy. Ornamental only, hidden from assistive tech.
interface Props {
  petals?: string;
  center?: string;
  size?: string;
  style?: string;
}
const { petals = 'var(--cream)', center = 'var(--butter)', size = '4rem', style } = Astro.props;
---

<svg class="flower" style={`--p:${petals};--c:${center};--s:${size};${style ?? ''}`} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <g class="flower__petals">
    {[0, 60, 120, 180, 240, 300].map((r) => <ellipse cx="50" cy="24" rx="15" ry="22" transform={`rotate(${r} 50 50)`} />)}
  </g>
  <circle cx="50" cy="50" r="14" />
</svg>

<style>
  .flower { position: absolute; width: var(--s); height: var(--s); pointer-events: none; animation: sway 6s ease-in-out infinite; }
  .flower__petals ellipse { fill: var(--p); stroke: var(--ink); stroke-width: 3; }
  .flower circle { fill: var(--c); stroke: var(--ink); stroke-width: 3; }
  @keyframes sway { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(8deg); } }
</style>
