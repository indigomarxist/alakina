---
import Cutout from './Cutout.astro';
import Sticker from './Sticker.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

const repoPhotos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

// Photos Alakina adds to Google Drive, pulled in by scripts/sync-drive.mjs before the
// build (newest first). Both globs match nothing when Drive isn't configured.
type DriveEntry = { id: string; file: string; alt: string; category: (typeof repoPhotos)[number]['data']['category'] };
const driveImages = import.meta.glob<ImageMetadata>('../assets/photos/drive/*/*.jpg', { eager: true, import: 'default' });
const driveManifest: DriveEntry[] =
  Object.values(import.meta.glob<DriveEntry[]>('../assets/photos/drive/manifest.json', { eager: true, import: 'default' }))[0] ?? [];
const drivePhotos = driveManifest
  .filter((e) => driveImages[`../assets/photos/drive/${e.file}`])
  .map((e) => ({ id: `drive-${e.id}`, data: { image: driveImages[`../assets/photos/drive/${e.file}`], alt: e.alt, category: e.category } }));

// Once her Drive folder has photos it is the whole gallery; the repo photos are
// only a fallback for builds without Drive (local dev, or before setup).
const photos = drivePhotos.length > 0 ? drivePhotos : repoPhotos;

const filters = [
  ['all', 'All'],
  ['digitals', 'Digitals'],
  ['performance', 'Performance'],
  ['photoshoots', 'Photoshoots'],
  ['runway', 'Runway'],
].filter(([key]) => key === 'all' || photos.some((p) => p.data.category === key));

// Desktop-folder colours for the category filters.
const folderColors: Record<string, string> = { all: '#f2c35b', digitals: '#ff7a6b', performance: '#8f8cf7', photoshoots: '#ff8fc8', runway: '#5fd3c4' };

// Large versions for the lightbox, generated at build time.
const items = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    full: await getImage({ src: p.data.image, width: Math.min(1800, p.data.image.width), format: 'webp' }),
  })),
);
---

<section class="section gallery-section velvet vt-pink dust torn-top" id="portfolio">
  <div class="container">
    <Sticker kind="cherry" size="4rem" rotate={-10} style="top:-3rem;right:15rem" />
    <Sticker kind="flower" size="3.2rem" rotate={12} style="top:5.5rem;right:22%;animation-delay:-2.5s" />
    <p class="gallery__note note note--pink hand" aria-hidden="true">click to zoom ♡</p>
    <div class="gallery__head torn-card paper">
      <span class="tape" style="top:-0.9rem;left:44%;transform:rotate(-3deg)" aria-hidden="true"></span>
      <p class="eyebrow">[01] Portfolio</p>
      <h2 class="section-title">Selected <Cutout text="work" /></h2>
    </div>
    <div class="filters" role="group" aria-label="Filter photos">
      {
        filters.map(([key, label], i) => (
          <button class="filters__btn" type="button" data-filter={key} aria-pressed={i === 0 ? 'true' : 'false'} style={`--f:${folderColors[key]}`}>
            <span class="folder" aria-hidden="true"></span>
            <span class="filters__label">{label}</span>
          </button>
        ))
      }
    </div>
    <ul class="masonry">
      {
        items.map((p, i) => (
          <li data-category={p.data.category}>
            {i % 5 === 1 && <span class="tape" aria-hidden="true" />}
            {i % 7 === 3 && <span class="tape tape--leopard" aria-hidden="true" />}
            <button class="masonry__item" type="button" data-full={p.full.src} data-alt={p.data.alt} aria-label={`View larger: ${p.data.alt}`}>
              <Image src={p.data.image} alt={p.data.alt} widths={[400, 640, 900]} sizes="(max-width: 800px) 50vw, 33vw" format="avif" />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img class="lightbox__img" alt="" />
    <button class="lightbox__btn lightbox__close" type="button" aria-label="Close">×</button>
    <button class="lightbox__btn lightbox__prev" type="button" aria-label="Previous photo">‹</button>
    <button class="lightbox__btn lightbox__next" type="button" aria-label="Next photo">›</button>
  </dialog>
</section>

<style>
  .gallery-section { --sc: #8a1a50; }
  .gallery-section .container { position: relative; }
  .gallery__head { display: inline-block; max-width: 100%; transform: rotate(-1.2deg); }
  .gallery__note { position: absolute; z-index: 3; top: 0.5rem; right: 1rem; margin: 0; width: 9rem; --r: 5deg; font-size: 1.35rem; text-align: center; color: var(--ink); }

  /* Category filters as desktop folders (after the Canva site she likes). */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2.5vw, 2rem);
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 clamp(2.25rem, 4vw, 3rem);
  }
  .filters__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 6.5rem;
    padding: 0.5rem 0.5rem 0.4rem;
    border: 2px solid transparent;
    border-radius: 6px;
    background: none;
    font: inherit;
    color: var(--cream);
    cursor: pointer;
    transition: transform 0.25s var(--ease), background 0.25s var(--ease);
  }
  .folder {
    position: relative;
    display: block;
    width: 4.6rem;
    height: 3.4rem;
    margin-top: 0.5rem;
    border-radius: 0 6px 6px 6px;
    background: linear-gradient(color-mix(in srgb, var(--f) 80%, white), var(--f));
    box-shadow: inset 0 -3px 0 color-mix(in srgb, var(--f) 70%, black), 2px 4px 6px rgb(0 0 0 / 0.35);
  }
  .folder::before {
    content: '';
    position: absolute;
    left: 0;
    top: -0.55rem;
    width: 45%;
    height: 0.75rem;
    border-radius: 5px 5px 0 0;
    background: color-mix(in srgb, var(--f) 85%, black);
  }
  .filters__label {
    padding: 0.1rem 0.4rem;
    font-family: var(--hand);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.1;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.7);
  }
  .filters__btn:hover { transform: translateY(-3px) rotate(-2deg); }
  .filters__btn[aria-pressed='true'] { background: rgb(255 255 255 / 0.18); border-color: rgb(255 255 255 / 0.55); border-style: dotted; }
  .filters__btn[aria-pressed='true'] .filters__label { background: #2f6db5; text-decoration: none; text-shadow: none; }

  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: clamp(1rem, 2.2vw, 1.75rem);
  }
  @media (max-width: 800px) { .masonry { columns: 2; } .gallery__note { display: none; } .container > :global(svg.sticker:nth-child(2)) { display: none; } }
  @media (max-width: 520px) {
    .filters__btn { min-width: 5.25rem; }
    .folder { width: 3.6rem; height: 2.7rem; }
    .filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding: 0.4rem var(--gutter); }
    .filters::-webkit-scrollbar { display: none; }
    .filters__btn { flex: none; }
  }
  .masonry li {
    position: relative;
    break-inside: avoid;
    padding: 0.5rem 0.3rem;
    margin-bottom: clamp(0.6rem, 1.5vw, 1rem);
  }
  .masonry li[hidden] { display: none; }
  .masonry li > .tape { top: -0.1rem; left: 50%; margin-left: -3.25rem; transform: rotate(-5deg); }
  .masonry li:nth-child(odd) > .tape { transform: rotate(6deg); }
  /* Prints on cream stock, scattered at different angles. */
  .masonry__item {
    display: block;
    width: 100%;
    padding: 0.5rem 0.5rem 1.6rem;
    border: 0;
    border-radius: 2px;
    background: var(--cream);
    cursor: zoom-in;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 16px 26px -12px rgb(0 0 0 / 0.7);
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  li:nth-child(6n + 1) .masonry__item { --tilt: -3deg; }
  li:nth-child(6n + 2) .masonry__item { --tilt: 2.2deg; }
  li:nth-child(6n + 3) .masonry__item { --tilt: -1.2deg; }
  li:nth-child(6n + 4) .masonry__item { --tilt: 3.4deg; }
  li:nth-child(6n + 5) .masonry__item { --tilt: -2.4deg; }
  li:nth-child(6n + 6) .masonry__item { --tilt: 1deg; }
  li:nth-child(4n + 2) .masonry__item { padding-bottom: 0.5rem; }
  .masonry__item :global(img) { display: block; width: 100%; height: auto; }
  .masonry__item:hover, .masonry__item:focus-visible {
    transform: rotate(0deg) scale(1.04);
    box-shadow: 0 2px 4px rgb(54 32 26 / 0.2), 0 26px 40px -16px rgb(54 32 26 / 0.6);
    z-index: 2;
    position: relative;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--wine) 94%, black);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox__img { max-width: calc(100vw - 7rem); max-height: calc(100dvh - 4rem); width: auto; height: auto; object-fit: contain; border: 0.5rem solid var(--cream); border-bottom-width: 2rem; transform: rotate(-1deg); }
  .lightbox__btn {
    position: absolute;
    background: none;
    border: 0;
    color: var(--cream);
    font-size: 2.75rem;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    font-family: var(--serif);
  }
  .lightbox__close { top: 0.75rem; right: 0.75rem; }
  .lightbox__prev { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 0.5rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .lightbox__img { max-width: 100vw; }
    .lightbox__prev, .lightbox__next { top: auto; bottom: 0.75rem; transform: none; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
  const cells = [...document.querySelectorAll<HTMLLIElement>('.masonry li')];
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('.filters__btn')];
  let visible = cells.map((li) => li.querySelector<HTMLButtonElement>('.masonry__item')!);
  let current = 0;

  filterBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cells.forEach((li) => (li.hidden = f !== 'all' && li.dataset.category !== f));
      visible = cells.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLButtonElement>('.masonry__item')!);
    }),
  );

  // The lightbox only steps through photos in the active filter.
  const show = (i: number) => {
    current = (i + visible.length) % visible.length;
    img.src = visible[current].dataset.full!;
    img.alt = visible[current].dataset.alt!;
  };

  cells.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.masonry__item')!;
    btn.addEventListener('click', () => {
      show(visible.indexOf(btn));
      dialog.showModal();
    });
  });
  dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lightbox__prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lightbox__next')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => visible[current].focus());
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
