---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

const filters = [
  ['all', 'All'],
  ['headshots', 'Headshots'],
  ['digitals', 'Digitals'],
  ['editorial', 'Editorial'],
  ['runway', 'Runway'],
  ['stage', 'Stage'],
].filter(([key]) => key === 'all' || photos.some((p) => p.data.category === key));

// Large versions for the lightbox, generated at build time.
const items = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    full: await getImage({ src: p.data.image, width: Math.min(1800, p.data.image.width), format: 'webp' }),
  })),
);
---

<section class="section" id="portfolio">
  <div class="container">
    <p class="eyebrow">Portfolio</p>
    <h2 class="section-title">Selected <em>work</em></h2>
    <div class="filters" role="group" aria-label="Filter photos">
      {
        filters.map(([key, label], i) => (
          <button class="filters__btn" type="button" data-filter={key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {label}
          </button>
        ))
      }
    </div>
    <ul class="masonry">
      {
        items.map((p) => (
          <li data-category={p.data.category}>
            <button class="masonry__item" type="button" data-full={p.full.src} data-alt={p.data.alt} aria-label={`View larger: ${p.data.alt}`}>
              <Image src={p.data.image} alt={p.data.alt} widths={[400, 640, 900]} sizes="(max-width: 800px) 50vw, 33vw" format="avif" />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img class="lightbox__img" alt="" />
    <button class="lightbox__btn lightbox__close" type="button" aria-label="Close">×</button>
    <button class="lightbox__btn lightbox__prev" type="button" aria-label="Previous photo">‹</button>
    <button class="lightbox__btn lightbox__next" type="button" aria-label="Next photo">›</button>
  </dialog>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: -0.75rem 0 clamp(1.75rem, 4vw, 2.75rem);
  }
  .filters__btn {
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.2s var(--ease-bounce), background 0.2s ease, box-shadow 0.2s ease;
  }
  .filters__btn:hover { transform: translateY(-2px); }
  .filters__btn[aria-pressed='true'] { box-shadow: 3px 3px 0 var(--ink); }
  .filters__btn[data-filter='all'][aria-pressed='true'] { background: var(--ink); color: var(--cream); }
  .filters__btn[data-filter='headshots'][aria-pressed='true'] { background: var(--blush); }
  .filters__btn[data-filter='digitals'][aria-pressed='true'] { background: var(--sky); }
  .filters__btn[data-filter='editorial'][aria-pressed='true'] { background: var(--butter); }
  .filters__btn[data-filter='runway'][aria-pressed='true'] { background: var(--sage); }
  .filters__btn[data-filter='stage'][aria-pressed='true'] { background: var(--tangerine); }

  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: clamp(0.75rem, 1.8vw, 1.25rem);
  }
  @media (max-width: 800px) { .masonry { columns: 2; } }
  .masonry li {
    break-inside: avoid;
    margin-bottom: clamp(0.75rem, 1.8vw, 1.25rem);
  }
  .masonry li[hidden] { display: none; }
  .masonry__item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--paper);
    cursor: zoom-in;
    overflow: hidden;
    transition: transform 0.3s var(--ease-bounce), box-shadow 0.3s ease;
  }
  .masonry__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  li:nth-child(5n + 1) .masonry__item { --pop: var(--cherry); }
  li:nth-child(5n + 2) .masonry__item { --pop: var(--cobalt); }
  li:nth-child(5n + 3) .masonry__item { --pop: var(--butter); }
  li:nth-child(5n + 4) .masonry__item { --pop: var(--tangerine); }
  li:nth-child(5n + 5) .masonry__item { --pop: var(--blush); }
  .masonry__item:hover, .masonry__item:focus-visible { transform: translate(-3px, -3px) rotate(-0.6deg); box-shadow: 6px 6px 0 var(--pop); }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--ink) 95%, transparent);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox__img { max-width: calc(100vw - 7rem); max-height: calc(100dvh - 4rem); width: auto; height: auto; object-fit: contain; border-radius: var(--radius); }
  .lightbox__btn {
    position: absolute;
    background: none;
    border: 0;
    color: var(--cream);
    font-size: 2.5rem;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    font-family: var(--serif);
  }
  .lightbox__close { top: 0.75rem; right: 0.75rem; }
  .lightbox__prev { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 0.5rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .lightbox__img { max-width: 100vw; }
    .lightbox__prev, .lightbox__next { top: auto; bottom: 0.75rem; transform: none; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
  const cells = [...document.querySelectorAll<HTMLLIElement>('.masonry li')];
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('.filters__btn')];
  let visible = cells.map((li) => li.querySelector<HTMLButtonElement>('.masonry__item')!);
  let current = 0;

  filterBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cells.forEach((li) => (li.hidden = f !== 'all' && li.dataset.category !== f));
      visible = cells.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLButtonElement>('.masonry__item')!);
    }),
  );

  // The lightbox only steps through photos in the active filter.
  const show = (i: number) => {
    current = (i + visible.length) % visible.length;
    img.src = visible[current].dataset.full!;
    img.alt = visible[current].dataset.alt!;
  };

  cells.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.masonry__item')!;
    btn.addEventListener('click', () => {
      show(visible.indexOf(btn));
      dialog.showModal();
    });
  });
  dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lightbox__prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lightbox__next')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => visible[current].focus());
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
