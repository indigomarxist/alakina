---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

const repoPhotos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

// Photos Alakina adds to Google Drive, pulled in by scripts/sync-drive.mjs before the
// build (newest first). Both globs match nothing when Drive isn't configured.
type DriveEntry = { id: string; file: string; alt: string; category: (typeof repoPhotos)[number]['data']['category'] };
const driveImages = import.meta.glob<ImageMetadata>('../assets/photos/drive/*/*.jpg', { eager: true, import: 'default' });
const driveManifest: DriveEntry[] =
  Object.values(import.meta.glob<DriveEntry[]>('../assets/photos/drive/manifest.json', { eager: true, import: 'default' }))[0] ?? [];
const drivePhotos = driveManifest
  .filter((e) => driveImages[`../assets/photos/drive/${e.file}`])
  .map((e) => ({ id: `drive-${e.id}`, data: { image: driveImages[`../assets/photos/drive/${e.file}`], alt: e.alt, category: e.category } }));

// Once her Drive folder has photos it is the whole gallery; the repo photos are
// only a fallback for builds without Drive (local dev, or before setup).
const photos = drivePhotos.length > 0 ? drivePhotos : repoPhotos;

const filters = [
  ['all', 'All'],
  ['digitals', 'Digitals'],
  ['performance', 'Performance'],
  ['photoshoots', 'Photoshoots'],
  ['runway', 'Runway'],
].filter(([key]) => key === 'all' || photos.some((p) => p.data.category === key));

// Large versions for the lightbox, generated at build time.
const items = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    full: await getImage({ src: p.data.image, width: Math.min(1800, p.data.image.width), format: 'webp' }),
  })),
);
---

<section class="section gallery-section paper" id="portfolio">
  <div class="container">
    <p class="eyebrow">Portfolio</p>
    <h2 class="section-title">Selected <em>work</em></h2>
    <div class="filters" role="group" aria-label="Filter photos">
      {
        filters.map(([key, label], i) => (
          <button class="filters__btn" type="button" data-filter={key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {label}
          </button>
        ))
      }
    </div>
    <ul class="masonry">
      {
        items.map((p) => (
          <li data-category={p.data.category}>
            <button class="masonry__item" type="button" data-full={p.full.src} data-alt={p.data.alt} aria-label={`View larger: ${p.data.alt}`}>
              <Image src={p.data.image} alt={p.data.alt} widths={[400, 640, 900]} sizes="(max-width: 800px) 50vw, 33vw" format="avif" />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img class="lightbox__img" alt="" />
    <button class="lightbox__btn lightbox__close" type="button" aria-label="Close">×</button>
    <button class="lightbox__btn lightbox__prev" type="button" aria-label="Previous photo">‹</button>
    <button class="lightbox__btn lightbox__next" type="button" aria-label="Next photo">›</button>
  </dialog>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -1rem 0 clamp(2rem, 4vw, 2.75rem);
  }
  .filters__btn {
    min-height: 2.75rem;
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--cream);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 480;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .filters__btn:hover { border-color: var(--burgundy); color: var(--burgundy); transform: rotate(-2deg); }
  .filters__btn[aria-pressed='true'] { background: var(--burgundy); border-color: var(--burgundy); color: var(--cream); }

  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: clamp(0.9rem, 2vw, 1.5rem);
  }
  @media (max-width: 800px) { .masonry { columns: 2; } }
  @media (max-width: 520px) {
    .filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); padding-block: 0.25rem; }
    .filters::-webkit-scrollbar { display: none; }
    .filters__btn { flex: none; }
  }
  .masonry li {
    break-inside: avoid;
    padding: 0.3rem;
    margin-bottom: clamp(0.6rem, 1.5vw, 1rem);
  }
  .masonry li[hidden] { display: none; }
  /* Each photo is a small print on cream stock, set slightly askew like a collage. */
  .masonry__item {
    display: block;
    width: 100%;
    padding: 0.4rem;
    border: 0;
    border-radius: 2px;
    background: var(--cream);
    cursor: zoom-in;
    box-shadow: 0 1px 2px rgb(54 32 26 / 0.18), 0 10px 22px -12px rgb(54 32 26 / 0.45);
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  li:nth-child(4n + 1) .masonry__item { --tilt: -1.2deg; }
  li:nth-child(4n + 2) .masonry__item { --tilt: 0.9deg; }
  li:nth-child(4n + 3) .masonry__item { --tilt: -0.5deg; }
  li:nth-child(4n + 4) .masonry__item { --tilt: 1.4deg; }
  .masonry__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .masonry__item:hover, .masonry__item:focus-visible {
    transform: rotate(0deg) scale(1.02);
    box-shadow: 0 2px 4px rgb(54 32 26 / 0.2), 0 22px 36px -16px rgb(54 32 26 / 0.55);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--wine) 94%, black);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox__img { max-width: calc(100vw - 7rem); max-height: calc(100dvh - 4rem); width: auto; height: auto; object-fit: contain; border: 0.4rem solid var(--cream); }
  .lightbox__btn {
    position: absolute;
    background: none;
    border: 0;
    color: var(--cream);
    font-size: 2.75rem;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    font-family: var(--serif);
  }
  .lightbox__close { top: 0.75rem; right: 0.75rem; }
  .lightbox__prev { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 0.5rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .lightbox__img { max-width: 100vw; }
    .lightbox__prev, .lightbox__next { top: auto; bottom: 0.75rem; transform: none; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
  const cells = [...document.querySelectorAll<HTMLLIElement>('.masonry li')];
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('.filters__btn')];
  let visible = cells.map((li) => li.querySelector<HTMLButtonElement>('.masonry__item')!);
  let current = 0;

  filterBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cells.forEach((li) => (li.hidden = f !== 'all' && li.dataset.category !== f));
      visible = cells.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLButtonElement>('.masonry__item')!);
    }),
  );

  // The lightbox only steps through photos in the active filter.
  const show = (i: number) => {
    current = (i + visible.length) % visible.length;
    img.src = visible[current].dataset.full!;
    img.alt = visible[current].dataset.alt!;
  };

  cells.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.masonry__item')!;
    btn.addEventListener('click', () => {
      show(visible.indexOf(btn));
      dialog.showModal();
    });
  });
  dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lightbox__prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lightbox__next')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => visible[current].focus());
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
