---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

const filters = [
  ['all', 'All'],
  ['headshots', 'Headshots'],
  ['digitals', 'Digitals'],
  ['editorial', 'Editorial'],
  ['runway', 'Runway'],
  ['stage', 'Stage'],
].filter(([key]) => key === 'all' || photos.some((p) => p.data.category === key));

// Large versions for the lightbox, generated at build time.
const items = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    full: await getImage({ src: p.data.image, width: Math.min(1800, p.data.image.width), format: 'webp' }),
  })),
);
---

<section class="section" id="portfolio">
  <div class="container">
    <p class="eyebrow">Portfolio</p>
    <h2 class="section-title">Selected work</h2>
    <div class="filters" role="group" aria-label="Filter photos">
      {
        filters.map(([key, label], i) => (
          <button class="filters__btn" type="button" data-filter={key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {label}
          </button>
        ))
      }
    </div>
    <ul class="masonry">
      {
        items.map((p) => (
          <li data-category={p.data.category}>
            <button class="masonry__item" type="button" data-full={p.full.src} data-alt={p.data.alt} aria-label={`View larger: ${p.data.alt}`}>
              <Image src={p.data.image} alt={p.data.alt} widths={[400, 640, 900]} sizes="(max-width: 800px) 50vw, 33vw" format="avif" />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img class="lightbox__img" alt="" />
    <button class="lightbox__btn lightbox__close" type="button" aria-label="Close">×</button>
    <button class="lightbox__btn lightbox__prev" type="button" aria-label="Previous photo">‹</button>
    <button class="lightbox__btn lightbox__next" type="button" aria-label="Next photo">›</button>
  </dialog>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: -1rem 0 clamp(1.5rem, 4vw, 2.5rem);
  }
  .filters__btn {
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0.35rem 0;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .filters__btn:hover { color: var(--text); }
  .filters__btn[aria-pressed='true'] { color: var(--text); border-bottom-color: var(--text); }

  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: clamp(0.5rem, 1.5vw, 1rem);
  }
  @media (max-width: 800px) { .masonry { columns: 2; } }
  .masonry li {
    break-inside: avoid;
    margin-bottom: clamp(0.5rem, 1.5vw, 1rem);
  }
  .masonry li[hidden] { display: none; }
  .masonry__item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    cursor: zoom-in;
    overflow: hidden;
  }
  .masonry__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s ease;
  }
  .masonry__item:hover :global(img) { transform: scale(1.03); }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(15, 14, 13, 0.94);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox__img { max-width: calc(100vw - 7rem); max-height: calc(100dvh - 4rem); width: auto; height: auto; object-fit: contain; }
  .lightbox__btn {
    position: absolute;
    background: none;
    border: 0;
    color: #f7f5f2;
    font-size: 2.5rem;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    font-family: var(--serif);
  }
  .lightbox__close { top: 0.75rem; right: 0.75rem; }
  .lightbox__prev { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 0.5rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .lightbox__img { max-width: 100vw; }
    .lightbox__prev, .lightbox__next { top: auto; bottom: 0.75rem; transform: none; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
  const cells = [...document.querySelectorAll<HTMLLIElement>('.masonry li')];
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('.filters__btn')];
  let visible = cells.map((li) => li.querySelector<HTMLButtonElement>('.masonry__item')!);
  let current = 0;

  filterBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cells.forEach((li) => (li.hidden = f !== 'all' && li.dataset.category !== f));
      visible = cells.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLButtonElement>('.masonry__item')!);
    }),
  );

  // The lightbox only steps through photos in the active filter.
  const show = (i: number) => {
    current = (i + visible.length) % visible.length;
    img.src = visible[current].dataset.full!;
    img.alt = visible[current].dataset.alt!;
  };

  cells.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.masonry__item')!;
    btn.addEventListener('click', () => {
      show(visible.indexOf(btn));
      dialog.showModal();
    });
  });
  dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lightbox__prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lightbox__next')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => visible[current].focus());
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
