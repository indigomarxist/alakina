---
import { profile } from '../data/profile';

const links = [
  ['Portfolio', '#portfolio'],
  ['Video', '#video'],
  ['About', '#about'],
  ['Resume', '#resume'],
  ['Social', '#social'],
  ['Contact', '#contact'],
];
---

<header class="header velvet vt-wine">
  <div class="container header__inner">
    <a href="#top" class="header__name">
      <span class="header__star" aria-hidden="true">✦</span>{profile.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map(([label, href], i) => <li><a href={href} style={`--t:${[-3, 2, -1, 3, -2, 1][i]}deg`}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    box-shadow: 0 10px 18px -12px rgb(0 0 0 / 0.7);
  }
  /* Leopard trim along the bottom edge. */
  .header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 7px;
    background: var(--leopard) 0 0 / 90px 90px;
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.35);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .header__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--cream);
  }
  .header__star { color: #ff8fc8; letter-spacing: 0; font-size: 0.9em; }
  ul { display: flex; gap: clamp(0.15rem, 0.9vw, 0.5rem); list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cream);
    transition: background 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  /* Hover: a pink label-maker tag. */
  nav a:hover, nav a:focus-visible {
    background: linear-gradient(#cc2f7d, #9c1450);
    color: #fff;
    transform: rotate(var(--t));
    box-shadow: 1px 2px 0 rgb(0 0 0 / 0.4);
  }
  @media (max-width: 900px) {
    .header { position: relative; }
    .header__inner { flex-direction: column; justify-content: center; height: auto; padding-block: 0.8rem 0.5rem; gap: 0.15rem; }
    ul { display: grid; grid-template-columns: repeat(3, auto); justify-content: center; gap: 0 0.5rem; }
    nav a { justify-content: center; padding: 0.4rem 0.5rem; font-size: 0.64rem; letter-spacing: 0.14em; }
  }
</style>
