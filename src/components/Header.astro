---
import { profile } from '../data/profile';

const links = [
  ['Portfolio', '#portfolio'],
  ['Video', '#video'],
  ['About', '#about'],
  ['Resume', '#resume'],
  ['Social', '#social'],
  ['Contact', '#contact'],
];
---

<header class="header">
  <div class="container header__inner">
    <a href="#top" class="header__name">{profile.name}</a>
    <nav aria-label="Main">
      <ul>
        {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--night) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.5rem;
  }
  .header__name {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  ul { display: flex; gap: clamp(0.25rem, 1.2vw, 0.75rem); list-style: none; margin: 0; padding: 0; }
  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.45rem 0.7rem;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.3s var(--ease);
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.55rem;
    height: 1px;
    background: var(--champagne);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  nav a:hover { color: var(--bone); }
  nav a:hover::after { transform: scaleX(1); }
  @media (max-width: 900px) {
    .header { position: relative; }
    .header__inner { flex-direction: column; justify-content: center; height: auto; padding-block: 0.9rem 0.4rem; gap: 0.2rem; }
    ul { display: grid; grid-template-columns: repeat(3, auto); justify-content: center; gap: 0 0.75rem; }
    nav a { justify-content: center; min-height: 2.5rem; }
    nav a { padding: 0.4rem 0.45rem; font-size: 0.62rem; letter-spacing: 0.12em; }
    nav a::after { left: 0.45rem; right: 0.45rem; }
  }
</style>
