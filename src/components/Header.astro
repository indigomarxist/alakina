---
import { profile } from '../data/profile';

const links = [
  ['Portfolio', '#portfolio'],
  ['Video', '#video'],
  ['About', '#about'],
  ['Resume', '#resume'],
  ['Social', '#social'],
  ['Contact', '#contact'],
];
---

<header class="header">
  <div class="container header__inner">
    <a href="#top" class="header__name">{profile.name}</a>
    <nav aria-label="Main">
      <ul>
        {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--cream) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid var(--ink);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .header__name {
    font-family: var(--serif);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 1.65rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .header__name::after { content: '.'; color: var(--cherry); }
  ul { display: flex; gap: clamp(0.4rem, 1.5vw, 0.9rem); list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.2s ease;
  }
  li:nth-child(6n + 1) a:hover { background: var(--butter); }
  li:nth-child(6n + 2) a:hover { background: var(--blush); }
  li:nth-child(6n + 3) a:hover { background: var(--sky); }
  li:nth-child(6n + 4) a:hover { background: var(--sage); }
  li:nth-child(6n + 5) a:hover { background: var(--butter); }
  li:nth-child(6n + 6) a:hover { background: var(--blush); }
  @media (max-width: 900px) {
    .header { position: relative; }
    .header__inner { flex-direction: column; justify-content: center; height: auto; padding-block: 0.6rem; gap: 0.2rem; }
    .header__name { font-size: 1.4rem; }
    ul { flex-wrap: wrap; justify-content: center; gap: 0 0.1rem; }
    nav a { padding: 0.4rem 0.5rem; font-size: 0.75rem; letter-spacing: 0.08em; }
  }
</style>
