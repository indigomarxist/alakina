---
import { profile } from '../data/profile';

const links = [
  ['Portfolio', '#portfolio'],
  ['Video', '#video'],
  ['About', '#about'],
  ['Resume', '#resume'],
  ['Social', '#social'],
  ['Contact', '#contact'],
];
---

<header class="header velvet vt-wine">
  <div class="container header__inner">
    <a href="#top" class="header__name">
{profile.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 3px solid var(--gold);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .header__name {
    padding: 0 1.1rem;
    border-left: 1px solid var(--gold);
    border-right: 1px solid var(--gold);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.9rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    color: var(--blush);
  }
  ul { display: flex; gap: clamp(0.25rem, 1.2vw, 1rem); list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.4rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--cream);
    transition: color 0.2s var(--ease);
  }
  nav a:hover, nav a:focus-visible { color: var(--bubble); }
  @media (max-width: 900px) {
    .header { position: relative; }
    .header__inner { flex-direction: column; justify-content: center; height: auto; padding-block: 0.9rem 0.4rem; gap: 0.3rem; }
    ul { display: grid; grid-template-columns: repeat(3, auto); justify-content: center; gap: 0 1rem; }
    nav a { justify-content: center; font-size: 0.85rem; }
  }
</style>
