---
import Win from './Win.astro';
import { Image } from 'astro:assets';
import { getInstagramPosts } from '../lib/instagram';
import { profile } from '../data/profile';

const posts = await getInstagramPosts(9);
const instagramUrl = `https://www.instagram.com/${profile.instagram}/`;
const tiktokUrl = `https://www.tiktok.com/@${profile.tiktok}`;
---

<section class="section social-section plaid torn-top" id="social">
  <div class="container">
    <div class="social__head torn-card paper">
      <span class="tape tape--leopard" style="top:-0.6rem;left:12%;transform:rotate(-5deg)" aria-hidden="true"></span>
      <p class="eyebrow">[ 05 ] Social</p>
      <h2 class="section-title">Follow <em>along</em></h2>
    </div>

    <div class:list={['social', { 'social--no-feed': posts.length === 0 }]}>
      {
        posts.length > 0 && (
          <div class="ig">
            <ul class="ig__grid">
              {posts.map((p) => (
                <li>
                  <a href={p.permalink} rel="noopener" class="ig__item">
                    <Image
                      src={p.imageUrl}
                      inferSize
                      alt={p.caption ? `Instagram post: ${p.caption}` : 'Instagram post by Alakina Lee'}
                      widths={[240, 400, 600]}
                      sizes="(max-width: 800px) 33vw, 20vw"
                      format="avif"
                    />
                  </a>
                </li>
              ))}
            </ul>
            <a class="handle" href={instagramUrl} rel="noopener">@{profile.instagram} on Instagram →</a>
          </div>
        )
      }

      <div class="tt">
        <Win title={`TikTok · @${profile.tiktok}`} status="plays right here" class="tt__win">
        <div class="tt__embed">
          <blockquote
            class="tiktok-embed"
            cite={tiktokUrl}
            data-unique-id={profile.tiktok}
            data-embed-type="creator"
            style="max-width: 780px; min-width: 288px;"
          >
            <section>
              <a target="_blank" rel="noopener" href={`${tiktokUrl}?refer=creator_embed`}>@{profile.tiktok}</a>
            </section>
          </blockquote>
        </div>
        </Win>
        {posts.length === 0 && <a class="handle" href={instagramUrl} rel="noopener">@{profile.instagram} on Instagram →</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .social-section { --sc: var(--wine); }
  .social__head { display: inline-block; margin-bottom: clamp(2rem, 4vw, 3rem); transform: rotate(1.4deg); }
  .social__head .section-title { margin-bottom: 1.25rem; }
  .social-section .container { position: relative; }
  .tt__win { transform: rotate(1.5deg); }
  .tt__win :global(.win__body) { padding: 0.4rem; }
  .social { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .social--no-feed { grid-template-columns: minmax(0, 40rem); }
  .ig__grid { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.5rem, 1.2vw, 0.8rem); }
  .ig__item { display: block; padding: 0.3rem; background: var(--white); box-shadow: 4px 4px 0 var(--cocoa); transition: transform 0.4s var(--ease); }
  li:nth-child(odd) .ig__item { transform: rotate(-1deg); }
  li:nth-child(even) .ig__item { transform: rotate(1deg); }
  .ig__item:hover { transform: rotate(0) scale(1.03); }
  .ig__item :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .handle { font-family: var(--mono); font-size: 0.85rem; color: var(--cream); }
  .handle:hover { color: var(--bubble); }
  .tt { display: grid; gap: 1.5rem; }
  .tt__embed { min-height: 22rem; background: var(--cream); color: var(--ink); overflow: hidden; }
  .tt__embed :global(blockquote) { margin: 0; }
  @media (max-width: 800px) { .social { grid-template-columns: 1fr; } }
</style>

<script>
  // TikTok's embed script is heavy, so fetch it only when the section approaches the viewport.
  const embed = document.querySelector('.tt__embed');
  if (embed) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        const script = document.createElement('script');
        script.src = 'https://www.tiktok.com/embed.js';
        script.async = true;
        document.body.append(script);
      },
      { rootMargin: '600px' },
    );
    observer.observe(embed);
  }
</script>
