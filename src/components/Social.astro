---
import { Image } from 'astro:assets';
import { getInstagramPosts } from '../lib/instagram';
import { profile } from '../data/profile';

const posts = await getInstagramPosts(9);
const instagramUrl = `https://www.instagram.com/${profile.instagram}/`;
const tiktokUrl = `https://www.tiktok.com/@${profile.tiktok}`;
---

<section class="section social-section scallop-top" id="social">
  <div class="container">
    <p class="eyebrow">Social</p>
    <h2 class="section-title">Follow <em>along</em></h2>

    <div class:list={['social', { 'social--no-feed': posts.length === 0 }]}>
      {
        posts.length > 0 && (
          <div class="ig">
            <ul class="ig__grid">
              {posts.map((p) => (
                <li>
                  <a href={p.permalink} rel="noopener" class="ig__item">
                    <Image
                      src={p.imageUrl}
                      inferSize
                      alt={p.caption ? `Instagram post: ${p.caption}` : 'Instagram post by Alakina Lee'}
                      widths={[240, 400, 600]}
                      sizes="(max-width: 800px) 33vw, 20vw"
                      format="avif"
                    />
                  </a>
                </li>
              ))}
            </ul>
            <a class="handle" href={instagramUrl} rel="noopener">@{profile.instagram} on Instagram →</a>
          </div>
        )
      }

      <div class="tt">
        <div class="tt__embed">
          <blockquote
            class="tiktok-embed"
            cite={tiktokUrl}
            data-unique-id={profile.tiktok}
            data-embed-type="creator"
            style="max-width: 780px; min-width: 288px;"
          >
            <section>
              <a target="_blank" rel="noopener" href={`${tiktokUrl}?refer=creator_embed`}>@{profile.tiktok}</a>
            </section>
          </blockquote>
        </div>
        {posts.length === 0 && <a class="handle" href={instagramUrl} rel="noopener">@{profile.instagram} on Instagram →</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .social-section { --sc: var(--cobalt); --accent: var(--gold-light); background: var(--cobalt); color: var(--ivory); --muted: color-mix(in srgb, var(--ivory) 78%, transparent); }
  .social-section :global(.eyebrow)::before { background: var(--gold-light); }
  .social-section :focus-visible { outline-color: var(--gold-light); }
  .social { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .social--no-feed { grid-template-columns: minmax(0, 40rem); }
  .ig__grid { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.35rem, 0.9vw, 0.6rem); }
  .ig__item { display: block; background: color-mix(in srgb, var(--ivory) 12%, transparent); overflow: hidden; border-radius: var(--radius); }
  .ig__item :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; transition: transform 0.9s var(--ease); }
  .ig__item:hover :global(img) { transform: scale(1.04); }
  .handle { font-size: 0.75rem; font-weight: 450; letter-spacing: 0.22em; text-transform: uppercase; text-decoration: none; color: var(--ivory); border-bottom: 1px solid var(--gold-light); padding-bottom: 0.25rem; }
  .handle:hover { color: var(--gold-light); }
  .tt { display: grid; gap: 1.5rem; }
  .tt__embed { min-height: 22rem; background: var(--ivory); color: var(--ink); border-radius: var(--radius); overflow: hidden; }
  .tt__embed :global(blockquote) { margin: 0; }
  @media (max-width: 800px) { .social { grid-template-columns: 1fr; } }
</style>

<script>
  // TikTok's embed script is heavy, so fetch it only when the section approaches the viewport.
  const embed = document.querySelector('.tt__embed');
  if (embed) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        const script = document.createElement('script');
        script.src = 'https://www.tiktok.com/embed.js';
        script.async = true;
        document.body.append(script);
      },
      { rootMargin: '600px' },
    );
    observer.observe(embed);
  }
</script>
