---
import { profile } from '../data/profile';

const words = [...profile.tagline.split('·').map((r) => r.trim()), profile.based, 'Now booking'];
const run = [...words, ...words];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[0, 1].map(() => (
      <ul>
        {run.map((w) => <li>{w}</li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--cherry);
    color: var(--ivory);
    border-block: 1px solid var(--gold);
    box-shadow: inset 0 4px 0 var(--cherry), inset 0 5px 0 color-mix(in srgb, var(--gold-light) 60%, transparent), inset 0 -4px 0 var(--cherry), inset 0 -5px 0 color-mix(in srgb, var(--gold-light) 60%, transparent);
  }
  .marquee__track { display: flex; width: max-content; animation: scroll 50s linear infinite; }
  ul { display: flex; list-style: none; margin: 0; padding: 0.6rem 0 0.8rem; }
  li {
    font-family: var(--script);
    font-size: clamp(2rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    white-space: nowrap;
    padding-inline: 1.6rem;
    display: flex;
    align-items: center;
    gap: 3.2rem;
  }
  li::after {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    background: var(--gold-light);
    clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%);
    margin-right: -1.6rem;
  }
  @keyframes scroll { to { transform: translateX(-50%); } }
</style>
