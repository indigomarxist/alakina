---
import { profile } from '../data/profile';

const words = [...profile.tagline.split('·').map((r) => r.trim()), profile.based, 'Now booking'];
const run = [...words, ...words];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[0, 1].map(() => (
      <ul>
        {run.map((w) => <li>{w}</li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--hot);
    color: #fff5f8;
    position: relative;
    z-index: 2;
    margin: -0.6rem -2rem;
    border-block: 3px solid var(--wine);
    transform: rotate(-1.5deg);
  }
  .marquee__track { display: flex; width: max-content; animation: scroll 50s linear infinite; }
  ul { display: flex; list-style: none; margin: 0; padding: 0.95rem 0; }
  li {
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
    padding-inline: 1.4rem;
    display: flex;
    align-items: center;
    gap: 2.8rem;
  }
  li::after { content: '✦'; margin-right: -1.4rem; }
  @keyframes scroll { to { transform: translateX(-50%); } }
</style>
