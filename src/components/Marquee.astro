---
import { profile } from '../data/profile';

const words = [...profile.tagline.split('·').map((r) => r.trim()), profile.based, 'Now booking'];
const run = [...words, ...words];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[0, 1].map(() => (
      <ul>
        {run.map((w) => <li>{w}</li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--night);
    border-block: 1px solid var(--line);
    color: var(--bone);
  }
  .marquee__track { display: flex; width: max-content; animation: scroll 60s linear infinite; }
  ul { display: flex; list-style: none; margin: 0; padding: 0.9rem 0 1.05rem; }
  li {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1.1;
    white-space: nowrap;
    padding-inline: 2rem;
    display: flex;
    align-items: center;
    gap: 4rem;
  }
  li::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    background: var(--champagne);
    transform: rotate(45deg);
    margin-right: -2rem;
  }
  @keyframes scroll { to { transform: translateX(-50%); } }
</style>
