---
import { profile } from '../data/profile';

const words = [...profile.tagline.split('·').map((r) => r.trim()), profile.based, 'Now booking'];
const run = [...words, ...words];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[0, 1].map(() => (
      <ul>
        {run.map((w) => <li>{w}</li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--rose);
    color: var(--wine);
    position: relative;
    z-index: 2;
    margin: -0.6rem -2rem;
    transform: rotate(-1.8deg);
    box-shadow: 0 10px 20px -10px rgb(0 0 0 / 0.5);
  }
  .marquee::before,
  .marquee::after { content: ''; position: absolute; left: 0; right: 0; height: 9px; background: var(--zebra) 0 0 / 90px 90px; }
  .marquee::before { top: 0; }
  .marquee::after { bottom: 0; }
  .marquee__track { display: flex; width: max-content; animation: scroll 50s linear infinite; }
  ul { display: flex; list-style: none; margin: 0; padding: 1.05rem 0 1.25rem; }
  li {
    font-family: var(--hand);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    line-height: 1.1;
    white-space: nowrap;
    padding-inline: 1.6rem;
    display: flex;
    align-items: center;
    gap: 3.2rem;
  }
  li::after {
    content: '';
    width: 0.85rem;
    height: 0.85rem;
    background: var(--wine);
    clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%);
    margin-right: -1.6rem;
  }
  @keyframes scroll { to { transform: translateX(-50%); } }
</style>
