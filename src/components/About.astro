---
import { Image } from 'astro:assets';
import portrait from '../assets/photos/three-quarter.jpg';
import { profile } from '../data/profile';
---

<section class="section about-section velvet vt-teal torn-top" id="about">
  <div class="container about">
    <div class="about__photo">
      <span class="tape tape--leopard" style="top:-0.6rem;left:12%;transform:rotate(-8deg)" aria-hidden="true"></span>
      <span class="tape" style="bottom:-0.4rem;right:8%;transform:rotate(-6deg)" aria-hidden="true"></span>
      <Image src={portrait} alt="Alakina Lee, three-quarter length portrait" widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 40vw" format="avif" />
    </div>
    <div class="about__col">
    <div class="about__page torn-card paper">
      <span class="tape" style="top:-0.2rem;left:40%;transform:rotate(3deg)" aria-hidden="true"></span>
      <p class="eyebrow">[ 03 ] About</p>
      <h2 class="section-title">Storytelling <em>first.</em></h2>
      {profile.bio.map((p) => <p class="about__text">{p}</p>)}

    </div>
    <div class="stats-card velvet vt-rose">
      <p class="stats-card__head"><span class="stats-card__label">Comp card · measurements</span><span class="stats-card__script" aria-hidden="true">vital stats</span></p>
      <dl class="stats" aria-label="Measurements">
        {
          profile.stats.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    </div>
  </div>
</section>

<style>
  .about-section { --sc: var(--teal); }
  .about { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  .about__col { display: grid; gap: 0; }
  .about__page { padding: 2.5rem clamp(1.5rem, 3.5vw, 3rem) 2.75rem; transform: rotate(-1deg); }
  .about__page .section-title { margin-bottom: 1.5rem; }
  /* A taped polaroid. */
  .about__photo {
    position: relative;
    padding: 0.7rem 0.7rem 3.4rem;
    background: var(--white);
    box-shadow: 6px 8px 0 var(--cocoa);
    transform: rotate(-3.5deg);
  }
  .about__photo::after {
    content: 'NYC, 2026';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    text-align: center;
    font-family: var(--script);
    font-size: 2rem;
    line-height: 1;
    color: var(--wine);
  }
  .about__photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
  .about__text { max-width: 58ch; margin: 0 0 1.25rem; }
  /* Comp-card stats panel in velvet rose, stitched seam at the foot. */
  .stats-card { position: relative; z-index: 1; margin: -1.25rem 1.5rem 0 clamp(1rem, 6vw, 4rem); padding: 1.75rem; transform: rotate(1.5deg); box-shadow: 8px 8px 0 var(--cocoa); }
  .stats-card__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 1rem; margin: 0 0 1.1rem; }
  .stats-card__label { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blush); }
  .stats-card__script { font-family: var(--script); font-size: 2rem; line-height: 1; color: var(--bubble); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem 1.25rem; margin: 0; padding-bottom: 1rem; border-bottom: 1px dashed var(--blush); }
  dt { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: color-mix(in srgb, var(--blush) 88%, transparent); }
  dd { margin: 0.2rem 0 0; font-family: var(--serif); font-size: 1.6rem; line-height: 1.1; color: var(--blush); }
  @media (max-width: 800px) {
    .about { grid-template-columns: 1fr; }
    .about__photo { width: min(76%, 22rem); margin: 1.5rem 0 2rem 1.5rem; }
    .stats-card { margin-inline: 0.5rem; }
  }
  @media (max-width: 520px) { .stats { grid-template-columns: repeat(2, 1fr); } }
</style>
