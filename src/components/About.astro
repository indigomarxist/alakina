---
import { Image } from 'astro:assets';
import portrait from '../assets/photos/three-quarter.jpg';
import { profile } from '../data/profile';
---

<section class="section about-section" id="about">
  <div class="container about">
    <div class="about__photo">
      <Image src={portrait} alt="Alakina Lee, three-quarter length portrait" widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 40vw" format="avif" />
    </div>
    <div>
      <p class="eyebrow">About</p>
      <h2 class="section-title">Storytelling <em>first.</em></h2>
      {profile.bio.map((p) => <p class="about__text">{p}</p>)}

      <dl class="stats" aria-label="Measurements">
        {
          profile.stats.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about-section { background: var(--night); }
  .about { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  .about__photo { position: relative; }
  .about__photo::before {
    content: '';
    position: absolute;
    inset: 1.1rem -1.1rem -1.1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--champagne) 55%, transparent);
    pointer-events: none;
  }
  .about__photo :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    filter: saturate(0.85) contrast(1.05);
  }
  .about__text { max-width: 58ch; margin: 0 0 1.25rem; color: color-mix(in srgb, var(--bone) 88%, transparent); }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 2.75rem 0 0;
    border-top: 1px solid var(--line);
  }
  .stats div {
    padding: 1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  dt { font-size: 0.68rem; font-weight: 400; letter-spacing: 0.26em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 0.2rem 0 0; font-family: var(--serif); font-size: 1.6rem; font-weight: 400; line-height: 1.2; }
  @media (max-width: 800px) {
    .about { grid-template-columns: 1fr; }
    .about__photo { width: min(85%, 26rem); }
  }
  @media (max-width: 520px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
