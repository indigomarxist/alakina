---
// A Y2K desktop pop-up window frame.
interface Props {
  title: string;
  class?: string;
  style?: string;
}
const { title, class: className, style } = Astro.props;
---

<div class:list={['win', className]} style={style}>
  <div class="win__bar">
    <span class="win__title">{title}</span>
    <span class="win__btns" aria-hidden="true">_ □ ×</span>
  </div>
  <div class="win__body"><slot /></div>
</div>

<style>
  /* The design system's Y2K window: hot pink frame, hard oxblood shadow. */
  .win {
    position: relative;
    background: #fff5f8;
    --text: var(--wine);
    --muted: var(--ink-soft);
    --line: color-mix(in srgb, var(--wine) 22%, transparent);
    --accent: var(--burgundy);
    color: var(--wine);
    border: 3px solid var(--hot);
    box-shadow: var(--hard);
  }
  .win__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.7rem;
    background: var(--hot);
    color: #fff5f8;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.3;
  }
  .win__btns { white-space: nowrap; }
  .win__body { padding: 1.1rem; }
</style>
