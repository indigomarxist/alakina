---
// A Y2K desktop pop-up window frame.
interface Props {
  title: string;
  class?: string;
  style?: string;
}
const { title, class: className, style } = Astro.props;
---

<div class:list={['win', className]} style={style}>
  <div class="win__bar">
    <span class="win__title">{title}</span>
    <span class="win__btns" aria-hidden="true"><i>_</i><i>□</i><i>×</i></span>
  </div>
  <div class="win__menu" aria-hidden="true"><span>File</span><span>Edit</span><span>Help</span></div>
  <div class="win__body"><slot /></div>
</div>

<style>
  .win {
    position: relative;
    background: #f3e7f0;
    --text: var(--ink);
    --muted: var(--ink-soft);
    --line: color-mix(in srgb, var(--ink) 20%, transparent);
    --accent: var(--burgundy);
    color: var(--ink);
    border: 2px solid #fff;
    outline: 1px solid #6b4a63;
    box-shadow: inset -2px -2px 0 #b996b0, inset 2px 2px 0 #fff, 6px 8px 0 rgb(42 22 23 / 0.25);
  }
  .win__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.2rem 0.3rem 0.2rem 0.6rem;
    background: linear-gradient(90deg, #c2185b, #7e3fbf 60%, #2f6db5);
    color: #fff;
    font-family: 'VT323', ui-monospace, monospace;
    font-size: 1.15rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-shadow: 1px 1px 0 rgb(0 0 0 / 0.35);
  }
  .win__btns { display: flex; gap: 0.2rem; }
  .win__btns i {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.05rem;
    font-style: normal;
    font-size: 0.9rem;
    line-height: 1;
    color: var(--ink);
    text-shadow: none;
    background: #f3e7f0;
    box-shadow: inset -1px -1px 0 #6b4a63, inset 1px 1px 0 #fff;
  }
  .win__menu {
    display: flex;
    gap: 0.9rem;
    padding: 0.15rem 0.6rem;
    font-family: 'VT323', ui-monospace, monospace;
    font-size: 1rem;
    color: #6b4a63;
    border-bottom: 1px solid #d7bccd;
  }
  .win__menu span::first-letter { text-decoration: underline; }
  .win__body { padding: 1rem; }
</style>
