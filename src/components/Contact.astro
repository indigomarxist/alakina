---
import Cutout from './Cutout.astro';
import Win from './Win.astro';
import Sticker from './Sticker.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/photos/headshot-bw.jpg';
import { profile } from '../data/profile';
import Sparkle from './Sparkle.astro';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
---

<section class="section contact velvet vt-wine torn-top" id="contact">
  <div class:list={["container", "contact__inner", { "contact__inner--single": !formspreeId }]}>
    <div>
      <p class="eyebrow">[06] Contact</p>
      <h2 class="section-title">Booking &amp; <Cutout text="casting" /></h2>
      <Win title="send_love.exe" class="contact__win">
      <p class="lead">For agency, casting, editorial and collaboration inquiries, get in touch directly.</p>
      <dl class="details">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
        </div>
        <div>
          <dt>Instagram</dt>
          <dd><a href={`https://www.instagram.com/${profile.instagram}/`} rel="noopener">@{profile.instagram}</a></dd>
        </div>
        <div>
          <dt>TikTok</dt>
          <dd><a href={`https://www.tiktok.com/@${profile.tiktok}`} rel="noopener">@{profile.tiktok}</a></dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{profile.based}</dd>
        </div>
      </dl>
      <div class="downloads">
        {!formspreeId && <a class="btn btn--solid" href={`mailto:${profile.email}?subject=Booking%20inquiry`}>Email Alakina</a>}
        <a class="btn" href={profile.files.compCard} download>Comp card (PDF)</a>
        <a class="btn" href={profile.files.resume} download>Resume (PDF)</a>
      </div>
      </Win>
    </div>

    {
      formspreeId ? (
        <form class="form" action={`https://formspree.io/f/${formspreeId}`} method="POST">
          <label>
            Name
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            Company / agency
            <input name="company" autocomplete="organization" />
          </label>
          <label>
            Message
            <textarea name="message" rows="5" required />
          </label>
          <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn--solid" type="submit">Send inquiry</button>
        </form>
      ) : (
        <div class="contact__photo">
          <Sticker kind="star" size="4.5rem" rotate={-14} style="top:-2rem;right:-1.5rem" />
          <Sticker kind="bow" size="3.4rem" rotate={10} float={false} style="bottom:-1.2rem;left:-1rem" />
          <p class="contact__scribble hand" aria-hidden="true">say hi!</p>
          <Sparkle color="var(--gold-light)" size="2rem" style="top:-0.75rem;left:-1.5rem;z-index:1" />
          <Sparkle color="var(--blush)" size="1.2rem" style="bottom:18%;right:-1.25rem;z-index:1;animation-delay:-2.2s" />
          <Image src={portrait} alt="Alakina Lee, black and white headshot" widths={[400, 640, 900]} sizes="(max-width: 800px) 0px, 36vw" format="avif" />
        </div>
      )
    }
  </div>
</section>

<style>
  .contact {
    --sc: var(--wine);
    --v: var(--wine);
  }
  .contact__inner { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .contact__inner--single { grid-template-columns: 7fr 5fr; align-items: center; }
  .contact__win { transform: rotate(-1deg); }
  .contact__win :global(.win__body) { padding: clamp(1.1rem, 3vw, 1.75rem); }
  .contact__scribble { position: absolute; z-index: 4; top: 42%; left: -4.5rem; margin: 0; font-size: 2.2rem; color: var(--gold-light); transform: rotate(-12deg); }
  .contact__photo { position: relative; }
  .contact__photo::before {
    content: '';
    position: absolute;
    inset: -1.1rem 1.1rem 1.1rem -1.1rem;
    border: 1px solid var(--gold-light);
    border-radius: 999px 999px var(--radius) var(--radius);
    pointer-events: none;
  }
  .contact__photo :global(img) { box-shadow: 0 0 0 1.5px var(--gold), 0 0 0 5px var(--wine), 0 0 0 6px var(--gold-light); }
  .contact__photo :global(img) { position: relative; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: 999px 999px var(--radius) var(--radius); }
  .lead { max-width: 46ch; margin: 0 0 1.5rem; font-family: var(--pixel); font-size: 1.45rem; line-height: 1.2; }
  .details { margin: 0 0 2.5rem; border-top: 1px solid var(--line); }
  .details div { display: grid; grid-template-columns: 8.5rem 1fr; padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
  dt { font-size: 0.68rem; font-weight: 450; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); align-self: center; }
  dd { margin: 0; font-family: var(--serif); font-size: 1.35rem; overflow-wrap: anywhere; }
  dd a { display: inline-block; padding-block: 0.4rem; text-decoration: none; background: linear-gradient(var(--hot), var(--hot)) 0 88% / 0 2px no-repeat; transition: background-size 0.4s var(--ease); }
  dd a:hover { background-size: 100% 2px; }
  .downloads { display: flex; flex-wrap: wrap; gap: 1rem; }
    .form { display: grid; gap: 1.25rem; }
  label { display: grid; gap: 0.4rem; font-size: 0.68rem; font-weight: 450; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }
  input, textarea {
    font: inherit;
    font-size: 1.05rem;
    letter-spacing: normal;
    text-transform: none;
    color: var(--cream);
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 50%, transparent);
    border-radius: 0;
    padding: 0.6rem 0;
    resize: vertical;
  }
  input:focus, textarea:focus { outline: none; border-bottom-color: var(--gold-light); }
  .form button { justify-self: start; margin-top: 0.75rem; }
  @media (max-width: 800px) {
    .contact__inner, .contact__inner--single { grid-template-columns: 1fr; }
    .contact__photo { display: none; }
    .contact__win { transform: none; }
  }
  @media (max-width: 420px) { .details div { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
