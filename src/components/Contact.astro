---
import { profile } from '../data/profile';
import Sparkle from './Sparkle.astro';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
---

<section class="section contact" id="contact">
  <Sparkle color="var(--butter)" size="3rem" style="top:12%;right:10%" />
  <Sparkle color="var(--blush)" size="1.6rem" style="top:30%;right:22%;animation-delay:-1.5s" />
  <Sparkle color="var(--sky)" size="2.2rem" style="bottom:14%;right:6%;animation-delay:-2.7s" />
  <div class:list={["container", "contact__inner", { "contact__inner--single": !formspreeId }]}>
    <div>
      <p class="eyebrow">Contact</p>
      <h2 class="section-title">Booking &amp; <em>casting</em></h2>
      <p class="lead">For agency, casting, editorial and collaboration inquiries, get in touch directly.</p>
      <dl class="details">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
        </div>
        <div>
          <dt>Instagram</dt>
          <dd><a href={`https://www.instagram.com/${profile.instagram}/`} rel="noopener">@{profile.instagram}</a></dd>
        </div>
        <div>
          <dt>TikTok</dt>
          <dd><a href={`https://www.tiktok.com/@${profile.tiktok}`} rel="noopener">@{profile.tiktok}</a></dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{profile.based}</dd>
        </div>
      </dl>
      <div class="downloads">
        {!formspreeId && <a class="btn btn--solid" href={`mailto:${profile.email}?subject=Booking%20inquiry`}>Email Alakina</a>}
        <a class="btn" href={profile.files.compCard} download>Comp card (PDF)</a>
        <a class="btn" href={profile.files.resume} download>Resume (PDF)</a>
      </div>
    </div>

    {
      formspreeId ? (
        <form class="form" action={`https://formspree.io/f/${formspreeId}`} method="POST">
          <label>
            Name
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            Company / agency
            <input name="company" autocomplete="organization" />
          </label>
          <label>
            Message
            <textarea name="message" rows="5" required />
          </label>
          <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn--solid" type="submit">Send inquiry</button>
        </form>
      ) : null
    }
  </div>
</section>

<style>
  .contact { background: var(--cherry); color: var(--cream); overflow: hidden; }
  .contact .eyebrow { color: var(--butter); }
  .contact h2 em { color: var(--butter); }
  .contact__inner { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .contact__inner--single { grid-template-columns: minmax(0, 42rem); }
  .lead { max-width: 46ch; margin: 0 0 2rem; font-size: 1.15rem; }
  .details { margin: 0 0 2.25rem; }
  .details div { display: grid; grid-template-columns: 8rem 1fr; padding: 0.8rem 0; border-bottom: 2px dotted color-mix(in srgb, var(--cream) 45%, transparent); }
  dt { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; align-self: center; }
  dd { margin: 0; font-family: var(--serif); font-size: 1.4rem; overflow-wrap: anywhere; }
  dd a { display: inline-block; padding-block: 0.4rem; text-decoration: none; text-decoration-line: underline; text-decoration-color: var(--butter); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  dd a:hover { color: var(--butter); }
  .downloads { display: flex; flex-wrap: wrap; gap: 1rem; }
  .contact .btn--solid { background: var(--butter); color: var(--ink); }
  .contact .btn--solid:hover, .contact .btn--solid:focus-visible { background: var(--cream); }
  .contact :focus-visible { outline-color: var(--butter); }
  .form { display: grid; gap: 1.1rem; background: var(--cream); color: var(--ink); padding: clamp(1.5rem, 4vw, 2.5rem); border: 2px solid var(--ink); border-radius: var(--radius); box-shadow: 8px 8px 0 var(--ink); }
  label { display: grid; gap: 0.4rem; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
  input, textarea {
    font: inherit;
    font-size: 1rem;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink);
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 0.75rem;
    padding: 0.65rem 0.85rem;
    resize: vertical;
  }
  input:focus, textarea:focus { outline: 3px solid var(--cobalt); outline-offset: 1px; }
  .form button { justify-self: start; margin-top: 0.5rem; }
  .form .btn--solid { background: var(--cherry); color: #fff; }
  @media (max-width: 800px) { .contact__inner { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .details div { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
